#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-3.0-or-later
# nikki-fleet agent: keeps an outbound connection to the nikki-fleet panel.

START=99
STOP=10
USE_PROCD=1

start_service() {
	config_load nikki-fleet
	local enabled server token
	config_get_bool enabled agent enabled 0
	config_get server agent server
	config_get token agent token
	[ "$enabled" = 1 ] && [ -n "$server" ] && [ -n "$token" ] || return 0

	procd_open_instance agent
	procd_set_param command /usr/bin/nikki-fleet agent
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nikki-fleet
}
