'use strict';

import { readfile, writefile, unlink, stat, mkdir } from 'fs';
import * as ops from '/usr/share/ucode/nikki_fleet/ops.uc';

const P = ops.P;
const q = ops.q;

function out(v) { print(sprintf('%.2J\n', v)); }
function log(msg) { warn(sprintf('[nikki-fleet] %s\n', msg)); }
function die(msg) { warn('error: ' + msg + '\n'); exit(1); }

/* ---------- HTTP to the panel ---------- */

function http(method, url, body, timeout, token, insecure, resolve) {
	let cmd = 'curl -sS -X ' + method + ' --max-time ' + int(timeout) + " -w '\\n%{http_code} %{remote_ip}' -H 'Accept: application/json'";
	if (insecure)
		cmd += ' -k';
	if (token)
		cmd += ' -H ' + q('Authorization: Bearer ' + token);
	if (resolve)
		cmd += ' --resolve ' + q(resolve);
	let f = null;
	if (body != null) {
		f = ops.tmpname('req') + '.json';
		writefile(f, sprintf('%J', body));
		cmd += " -H 'Content-Type: application/json' --data-binary @" + q(f);
	}
	const r = ops.sh(cmd + ' ' + q(url));
	if (f)
		unlink(f);
	// ucode 24.10: rindex() returns -1 for a match at index 0 (empty body), hence the prefix
	const o = '.' + r.out, nl = rindex(o, '\n');
	const tailv = nl > 0 ? split(substr(o, nl + 1), ' ') : [];
	const code = int(tailv[0] ?? 0);
	const text = nl > 0 ? substr(o, 1, nl - 1) : r.out;
	let data = null;
	try { data = length(text) ? json(text) : null; } catch (e) {}
	return { ok: code >= 200 && code < 300, code: code, data: data, error: code ? null : trim(text),
		ip: tailv[1] ?? '' };
}

/* The panel address is remembered after every successful request. If DNS on
 * the router breaks (for example mihomo hands out fake-ip addresses while the
 * router's own traffic is not proxied), the agent connects to the remembered
 * address directly so the panel can still reach the router and fix it. */

function host_port(url) {
	const m = match(url, /^(https?):\/\/([^\/:]+)(:([0-9]+))?/);
	return m ? { host: m[2], port: m[4] ?? (m[1] == 'https' ? '443' : '80') } : null;
}

function usable_ip(ip) {
	return ip && !match(ip, /^198\.1[89]\./) && !match(ip, /^(0\.|127\.)/) && ip != '::1';
}

function panel_post(cfg, path, body, timeout) {
	let r = http('POST', cfg.server + path, body, timeout, cfg.token, cfg.insecure);
	const hp = host_port(cfg.server);
	if (r.ok && usable_ip(r.ip)) {
		if (r.ip != cfg.last_ip) {
			cfg.last_ip = r.ip;
			writefile(P.state + '/panel_ip', r.ip);
		}
	} else if (r.code == 0 && hp && usable_ip(cfg.last_ip) && cfg.last_ip != r.ip) {
		const ip = index(cfg.last_ip, ':') >= 0 ? '[' + cfg.last_ip + ']' : cfg.last_ip;
		const r2 = http('POST', cfg.server + path, body, timeout, cfg.token, cfg.insecure,
			hp.host + ':' + hp.port + ':' + ip);
		if (r2.code != 0)
			return r2;
	}
	return r;
}

function agent_cfg() {
	return {
		server: rtrim(ops.uci_get('nikki-fleet.agent.server') ?? '', '/'),
		token: ops.uci_get('nikki-fleet.agent.token') ?? '',
		router_id: ops.uci_get('nikki-fleet.agent.router_id') ?? '',
		insecure: ops.uci_get('nikki-fleet.agent.insecure') == '1',
		enabled: ops.uci_get('nikki-fleet.agent.enabled') == '1',
		last_ip: trim(readfile(P.state + '/panel_ip') ?? ''),
	};
}

/* ---------- safety: auto-rollback if the panel becomes unreachable ---------- */

const PENDING_WINDOW = 180;

function set_pending(p) {
	mkdir(P.state);
	p.deadline = time() + PENDING_WINDOW;
	writefile(P.pending, sprintf('%J', p));
}

function get_pending() {
	const t = readfile(P.pending);
	try { return t ? json(t) : null; } catch (e) { return null; }
}

function clear_pending() { unlink(P.pending); }

// Returns an event to report if a rollback happened.
function check_pending() {
	const p = get_pending();
	if (!p || time() < p.deadline)
		return null;
	clear_pending();
	log(sprintf('panel unreachable after config change, restoring %s', p.backup));
	const r = ops.restore_backup(p.kind, p.name, p.backup, true);
	return { type: 'auto_rollback', ok: r.ok, profile: p.name, backup: p.backup,
		message: 'Panel was unreachable for 3 minutes after the config change; previous version restored' };
}

/* ---------- command execution (whitelist) ---------- */

const API_DENY = [ /^PUT \/configs/, /^POST \/restart/, /^POST \/upgrade/, /^POST \/configs\/geo/, /^DELETE \/configs/ ];

function api_allowed(method, path) {
	const key = uc(`${method}`) + ' ' + path;
	for (let re in API_DENY)
		if (match(key, re))
			return false;
	return true;
}

function a_kind(a) { return a?.kind == 'subscription' ? 'subscription' : 'file'; }

const COMMANDS = {
	'agent.ping': a => ({ pong: time() }),
	'status': a => ops.status(!!a?.full),
	'profiles.list': a => ({ active: ops.active_profile(), profiles: ops.list_profiles() }),
	'profile.read': a => ops.read_profile(a_kind(a), a?.name),
	'profile.test': a => ops.test_config(a?.content),
	'profile.write': a => {
		const r = ops.write_profile({ kind: a_kind(a), name: a?.name, content: a?.content,
			activate: !!a?.activate, reload: a?.reload !== false });
		if (r.ok && r.reloaded && r.backup)
			set_pending({ kind: a_kind(a), name: a?.name, backup: r.backup });
		return r;
	},
	'backups.list': a => ({ backups: ops.list_backups(a_kind(a), a?.name) }),
	'backup.restore': a => ops.restore_backup(a_kind(a), a?.name, a?.id, a?.reload !== false),
	'nikki.enable': a => ops.set_enabled(a?.enabled !== false),
	'nikki.reload': a => { const r = ops.reload_nikki(); return { ok: r.code == 0, api: ops.wait_api(20) }; },
	'subscription.update': a => ops.update_subscription(a?.section),
	'logs.tail': a => ops.logs_tail(a?.which, a?.lines),
	'traffic': a => ops.traffic(a?.limit),
	'proxies': a => ops.proxies(),
	'fleet.update': a => { const c = agent_cfg(); return ops.self_update(c.server, c.insecure); },
	'mihomo.api': a => {
		if (!api_allowed(a?.method ?? 'GET', `${a?.path}`))
			return { ok: false, error: 'this API call is not allowed remotely' };
		return ops.api(a?.method, a?.path, a?.body, 30);
	},
};

function execute(cmd) {
	const fn = COMMANDS[cmd?.type];
	if (!fn)
		return { id: cmd?.id, ok: false, error: 'unknown command: ' + cmd?.type };
	try {
		const data = fn(cmd.args ?? {});
		const ok = type(data) == 'object' && exists(data, 'ok') ? !!data.ok : true;
		return { id: cmd.id, ok: ok, data: data };
	} catch (e) {
		return { id: cmd.id, ok: false, error: `${e}` };
	}
}

/* ---------- agent loop ---------- */

function agent_run() {
	let cfg = agent_cfg();
	if (!cfg.server || !cfg.token)
		die('agent is not enrolled: run  nikki-fleet enroll <panel-url> <code>');
	mkdir(P.state);
	log('agent ' + ops.VERSION + ' started, panel ' + cfg.server);
	let results = [], events = [], last_status = 0, backoff = 2, status_interval = 60;
	try {
		const ev = check_pending();
		if (ev) push(events, ev);
	} catch (e) {
		log('pending check failed: ' + e);
	}

	// Every iteration is guarded: an unexpected error must never stop the
	// agent, otherwise the router silently drops out of the panel.
	while (true) {
		let wait = 0;
		try {
			const send_status = time() - last_status >= status_interval;
			let st = null;
			if (send_status) {
				try { st = ops.status(true); } catch (e) { st = { status_error: `${e}` }; }
			}
			const body = { agent_version: ops.VERSION, results: results, events: events, status: st };
			const r = panel_post(cfg, '/api/agent/v1/poll', body, 75);
			if (!r.ok) {
				if (r.code == 401 || r.code == 410) {
					log('panel rejected the token (router removed?), sleeping 10 min');
					wait = 600;
				} else {
					log(sprintf('poll failed (%s), retry in %ds', r.code ? 'HTTP ' + r.code : r.error, backoff));
					const e = check_pending();
					if (e) push(events, e);
					wait = backoff;
					backoff = backoff < 30 ? backoff * 2 : 30;
				}
			} else {
				backoff = 2;
				results = [];
				events = [];
				if (send_status)
					last_status = time();
				if (get_pending())
					clear_pending();   // panel reachable with the new config — keep it
				status_interval = r.data?.status_interval ?? status_interval;
				for (let cmd in (r.data?.commands ?? [])) {
					push(results, execute(cmd));
					if (cmd.type == 'status')
						last_status = time();
				}
			}
		} catch (e) {
			log('agent error: ' + e + (e?.stacktrace ? ' ' + sprintf('%J', e.stacktrace) : ''));
			results = [];
			wait = 10;
		}
		if (wait) {
			sleep(wait * 1000);
			if (wait >= 600)
				cfg = agent_cfg();
		}
	}
}

function enroll(server, code, insecure) {
	server = rtrim(server ?? '', '/');
	if (!match(server, /^https?:\/\//) || !code)
		die('usage: nikki-fleet enroll <https://panel> <code> [--insecure]');
	const st = ops.status(false);
	const r = http('POST', server + '/api/agent/v1/enroll',
		{ code: code, info: { hostname: st.hostname, board: st.board, fleet_version: ops.VERSION, nikki: st.nikki } },
		30, null, insecure);
	if (!r.ok)
		die('enrollment failed: ' + (r.data?.error ?? r.error ?? ('HTTP ' + r.code)));
	ops.sh('touch ' + q((P.uci_conf ?? '/etc/config') + '/nikki-fleet'));
	ops.sh((P.uci_conf ? 'uci -q -c ' + q(P.uci_conf) : 'uci -q') + ' set nikki-fleet.agent=agent');
	ops.uci_set('nikki-fleet.agent.server', server);
	ops.uci_set('nikki-fleet.agent.token', r.data.token);
	ops.uci_set('nikki-fleet.agent.router_id', r.data.router_id);
	ops.uci_set('nikki-fleet.agent.insecure', insecure ? '1' : '0');
	ops.uci_set('nikki-fleet.agent.enabled', '1');
	ops.uci_commit('nikki-fleet');
	return r.data;
}

/* ---------- CLI ---------- */

const USAGE = `nikki-fleet ${ops.VERSION}
usage:
  nikki-fleet status [--full]            router, Nikki and mihomo status (JSON)
  nikki-fleet profiles                   list profiles and the active one
  nikki-fleet read <name> [subscription] print a profile
  nikki-fleet test <file>                check a config with mihomo -t
  nikki-fleet write <name> <file> [--activate] [--no-reload]
                                         safely write a profile (test, backup, reload, rollback)
  nikki-fleet backups <name>             list backups of a profile
  nikki-fleet restore <name> <backup-id> restore a backup
  nikki-fleet enable | disable           turn Nikki on (with a health check) or off
  nikki-fleet api <METHOD> <path> [json] call the mihomo API
  nikki-fleet enroll <panel-url> <code> [--insecure]
                                         connect this router to a nikki-fleet panel
  nikki-fleet unenroll                   disconnect from the panel
  nikki-fleet agent                      run the agent (used by the service)
  nikki-fleet watchdog                   restore the previous profile if a change was not confirmed
  nikki-fleet doctor                     diagnose the connection to the panel
  nikki-fleet update [panel-url]         upgrade nikki-fleet packages in the background
  nikki-fleet starter <name> <url> [--profile=file.yaml]
                                         create a working profile from the starter template
`;

const argv = ARGV;
const has = f => index(argv, f) >= 0;
const args = filter(argv, a => substr(a, 0, 2) != '--');

switch (args[0]) {
case 'status':
	out(ops.status(has('--full')));
	break;
case 'profiles':
	out({ active: ops.active_profile(), profiles: ops.list_profiles() });
	break;
case 'read': {
	const r = ops.read_profile(args[2] == 'subscription' ? 'subscription' : 'file', args[1]);
	if (!r.ok) die(r.error);
	print(r.content);
	break;
}
case 'test': {
	const c = readfile(args[1] ?? '/dev/null');
	const r = ops.test_config(c);
	out(r);
	exit(r.ok ? 0 : 2);
}
case 'write': {
	const c = readfile(args[2] ?? '/dev/null');
	const r = ops.write_profile({ kind: 'file', name: args[1], content: c, activate: has('--activate'), reload: !has('--no-reload') });
	out(r);
	exit(r.ok ? 0 : 2);
}
case 'backups':
	out(ops.list_backups('file', args[1]));
	break;
case 'enable':
case 'disable': {
	const r = ops.set_enabled(args[0] == 'enable');
	out(r);
	exit(r.ok ? 0 : 2);
}
case 'restore': {
	const r = ops.restore_backup('file', args[1], args[2], true);
	out(r);
	exit(r.ok ? 0 : 2);
}
case 'api': {
	const r = ops.api(args[1], args[2], args[3] ?? null);
	out(r);
	exit(r.ok ? 0 : 2);
}
case 'enroll': {
	const d = enroll(args[1], args[2], has('--insecure'));
	print('enrolled as router ' + d.router_id + '\n');
	ops.sh('/etc/init.d/nikki-fleet enable; /etc/init.d/nikki-fleet restart');
	break;
}
case 'unenroll':
	ops.uci_set('nikki-fleet.agent.enabled', '0');
	ops.uci_set('nikki-fleet.agent.token', '');
	ops.uci_commit('nikki-fleet');
	ops.sh('/etc/init.d/nikki-fleet stop; /etc/init.d/nikki-fleet disable');
	print('disconnected from the panel\n');
	break;
case 'agent':
	agent_run();
	break;
case 'watchdog': {
	const e = check_pending();
	out(e ?? { pending: get_pending() });
	break;
}
case 'doctor': {
	// one command that collects what is needed to find out why the router is offline
	const cfg = agent_cfg();
	const hp = host_port(cfg.server);
	const sec = t => print('\n== ' + t + '\n');
	print('nikki-fleet ' + ops.VERSION + ', panel ' + (cfg.server || '(not enrolled)') + ', enabled ' + cfg.enabled + '\n');
	sec('service');
	print(ops.sh("ubus call service list '{\"name\":\"nikki-fleet\"}'; /etc/init.d/nikki-fleet enabled && echo autostart: yes || echo autostart: no").out);
	sec('agent log');
	print(ops.sh('logread -e nikki-fleet 2>/dev/null | tail -n 25').out);
	if (hp) {
		sec('dns ' + hp.host + ' (remembered ip: ' + (cfg.last_ip || '-') + ')');
		print(ops.sh('nslookup ' + q(hp.host) + ' 2>&1 | tail -n 4').out);
		sec('panel');
		const r = http('GET', cfg.server + '/api/info', null, 15, null, cfg.insecure);
		print((r.ok ? 'reachable, ip ' + r.ip : 'NOT reachable: ' + (r.error ?? 'HTTP ' + r.code)) + '\n');
	}
	sec('nikki');
	const st = ops.status(false);
	print(sprintf('enabled %s, running %s, mihomo api %s\n', st.nikki.enabled, st.nikki.running, st.mihomo.reachable));
	print(ops.sh('free | head -n 2; df -h /overlay /tmp 2>/dev/null').out);
	break;
}
case 'starter': {
	// fill the starter template with one subscription and make it the active profile
	const name = args[1], url = args[2];
	if (!match(name ?? '', /^[A-Za-z0-9_-]{1,32}$/) || !match(url ?? '', /^https?:\/\/[^ "\\]+$/))
		die('usage: nikki-fleet starter <name> <subscription-url>   (name: letters, digits, _ or -)');
	const tpl = readfile(P.starter);
	if (!tpl)
		die('template not found: ' + P.starter);
	const prof = filter(argv, a => match(a, /^--profile=/))[0];
	let content = replace(tpl, '__NAME__', name);
	content = replace(content, '__URL__', url);
	content = replace(content, '__HWID__', ops.uid());
	const r = ops.write_profile({ kind: 'file', name: prof ? substr(prof, 10) : 'nikki-fleet.yaml', content: content,
		activate: true, reload: true });
	out(r);
	exit(r.ok ? 0 : 2);
}
case 'update': {
	const c = agent_cfg();
	const r = ops.self_update(c.server || args[1], c.insecure);
	out(r);
	if (r.ok) print('log: ' + ops.UPDATE_LOG + '\n');
	exit(r.ok ? 0 : 2);
}
case 'version':
	print(ops.VERSION + '\n');
	break;
default:
	print(USAGE);
	exit(args[0] ? 1 : 0);
}
